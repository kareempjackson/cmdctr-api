generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id                       String            @id @default(uuid())
    email                    String            @unique
    password                 String
    name                     String?
    role                     String?
    onboarded                Boolean           @default(false)
    verified                 Boolean           @default(false)
    verificationToken        String?
    verificationTokenExpires DateTime?
    createdAt                DateTime          @default(now())
    updatedAt                DateTime          @updatedAt
    hasSeenJoyride           Boolean           @default(false)
    workspaces               Workspace[]
    loginEvents              LoginEvent[]
    WorkspaceMember          WorkspaceMember[]
    activityLogs             ActivityLog[]
    auditTrails              AuditTrail[]
    createdKnowledgeEntries  KnowledgeEntry[]  @relation("KnowledgeEntryCreator")
    modifiedKnowledgeEntries KnowledgeEntry[]  @relation("KnowledgeEntryModifier")
    knowledgeTrainings       KnowledgeTraining[]
    notes                    Note[]            @relation("NoteCreator")
    jots                     Jot[]             @relation("JotCreator")
    notifications            Notification[]    @relation("NotificationRecipient")
    notificationPreferences  NotificationPreference[] @relation("NotificationPreferences")
    notificationDigests      NotificationDigest[] @relation("NotificationDigests")
    ownedProjects            Project[]         @relation("ProjectOwner")
    createdCanvases          Canvas[]          @relation("CanvasCreator")
    createdBlocks            Block[]           @relation("BlockCreator")
    assistantMessages        AssistantMessage[]
    preferences              Json?
    usage                    Usage?
    customActions            CustomAction[]
    workflows                Workflow[]
    createdAgentTasks        AgentTask[]      @relation("AgentTaskCreator")
    // Profile fields
    username                 String?           @unique
    bio                      String?
    linkedin                 String?
    twitter                  String?
    avatar                   String?
    twoFASecret              String?
    twoFAEnabled             Boolean           @default(false)
    chatChannels             ChatChannel[]     @relation("UserChatChannels")
    chatChannelMembers       ChatChannelMember[] @relation("UserChatChannelMembers")
    chatMessages             ChatMessage[]     @relation("UserChatMessages")
    feedbacks                Feedback[]        @relation("UserFeedbacks")
}

model Workspace {
    id              String            @id @default(uuid())
    name            String
    createdBy       String
    createdAt       DateTime          @default(now())
    members         WorkspaceMember[]
    agents          Agent[]
    creator         User              @relation(fields: [createdBy], references: [id])
    activityLogs    ActivityLog[]
    auditTrails     AuditTrail[]
    knowledgeEntries KnowledgeEntry[]
    knowledgeTags   KnowledgeTag[]
    canvasLayouts   CanvasLayout[]
    notes           Note[]
    jots            Jot[]
    notifications   Notification[]
    notificationPreferences NotificationPreference[]
    notificationDigests NotificationDigest[]
    projects        Project[]
    assistantMessages AssistantMessage[]
    workflows       Workflow[]
    chatChannels    ChatChannel[]     @relation("WorkspaceChatChannels")
}

model WorkspaceMember {
    id          String    @id @default(uuid())
    userId      String
    workspaceId String
    role        String
    user        User      @relation(fields: [userId], references: [id])
    workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Agent {
    id                String              @id @default(uuid())
    name              String
    purpose           String
    config            Json
    memoryScope       String              @default("workspace") // workspace, project, personal
    permissions       Json                @default("{\"canAccessFiles\": true, \"canReadJots\": true, \"canTakeActions\": true}")
    icon              String              @default("🤖")
    role              String              @default("Assistant")
    model             String              @default("GPT-4")
    workspaceId       String
    createdAt         DateTime            @default(now())
    workspace         Workspace           @relation(fields: [workspaceId], references: [id])
    AgentMemory       AgentMemory[]
    AgentTrainingFile AgentTrainingFile[]
    agentTasks        AgentTask[]
    activityLogs      ActivityLog[]
    knowledgeAccess   KnowledgeAgentAccess[]
    projectAgents     ProjectAgent[]
}

model AgentMemory {
    id        String   @id @default(uuid())
    agentId   String
    agent     Agent    @relation(fields: [agentId], references: [id])
    input     String
    output    String
    createdAt DateTime @default(now())
}

model LoginEvent {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    ip        String
    userAgent String
    device    String
    location  String?
    createdAt DateTime @default(now())
}

model AgentTrainingFile {
    id          String   @id @default(uuid())
    agentId     String
    agent       Agent    @relation(fields: [agentId], references: [id])
    fileName    String
    fileType    String
    fileSize    Int
    storagePath String   // Local path or S3 URL
    uploadedAt  DateTime @default(now())
    status      String   @default("ready") // processing, ready, error
}

model ActivityLog {
    id          String     @id @default(uuid())
    userId      String?    // Nullable for system events
    workspaceId String?    // Nullable for user-level events
    agentId     String?    // Nullable for non-agent events
    
    // Event Classification
    category    String     // 'auth', 'agent', 'workspace', 'file', 'system'
    action      String     // 'login', 'execute', 'upload', 'delete', etc.
    resource    String?    // Resource identifier (file ID, agent ID, etc.)
    
    // Event Details
    description String
    metadata    Json?      // Flexible metadata storage
    ipAddress   String?
    userAgent   String?
    
    // Status & Timing
    status      String     // 'success', 'error', 'warning', 'info'
    duration    Int?       // Duration in milliseconds
    timestamp   DateTime   @default(now())
    
    // Relations
    user        User?      @relation(fields: [userId], references: [id])
    workspace   Workspace? @relation(fields: [workspaceId], references: [id])
    agent       Agent?     @relation(fields: [agentId], references: [id])
    
    @@index([category, action])
    @@index([timestamp])
    @@index([userId])
    @@index([workspaceId])
    @@index([agentId])
}

model AuditTrail {
    id           String    @id @default(uuid())
    userId       String
    workspaceId  String
    
    // Change Tracking
    entityType   String    // 'agent', 'workspace', 'user', 'file'
    entityId     String
    action       String    // 'create', 'update', 'delete'
    
    // Change Details
    fieldChanges Json?     // Before/after values
    reason       String?   // Optional reason for change
    
    timestamp    DateTime  @default(now())
    
    // Relations
    user         User      @relation(fields: [userId], references: [id])
    workspace    Workspace @relation(fields: [workspaceId], references: [id])
    
    @@index([entityType, entityId])
    @@index([timestamp])
    @@index([userId])
    @@index([workspaceId])
}

model KnowledgeEntry {
    id              String                   @id @default(uuid())
    workspaceId     String
    type            String                   // 'prompt', 'document', 'page'
    title           String
    description     String?
    content         String?                  // For prompts and pages
    fileUrl         String?                  // For documents
    fileName        String?                  // Original file name
    fileSize        Int?                     // File size in bytes
    mimeType        String?                  // File MIME type
    status          String                   @default("draft") // 'draft', 'published', 'archived'
    version         Int                      @default(1)
    
    // Metadata
    createdBy       String
    lastModifiedBy  String?
    createdAt       DateTime                 @default(now())
    updatedAt       DateTime                 @updatedAt
    
    // Training Status
    trainingStatus  String                   @default("untrained") // 'untrained', 'training', 'trained', 'failed'
    lastTrainedAt   DateTime?
    trainingMetrics Json?                    // Accuracy, confidence, etc.
    
    // Relations
    workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    creator         User                     @relation("KnowledgeEntryCreator", fields: [createdBy], references: [id])
    lastModifier    User?                    @relation("KnowledgeEntryModifier", fields: [lastModifiedBy], references: [id])
    tags            KnowledgeTag[]
    agentAccess     KnowledgeAgentAccess[]
    trainingHistory KnowledgeTraining[]
    
    @@index([workspaceId])
    @@index([type])
    @@index([status])
    @@index([trainingStatus])
    @@index([createdAt])
}

model KnowledgeTag {
    id              String           @id @default(uuid())
    name            String
    color           String?          // Hex color for UI
    workspaceId     String
    createdAt       DateTime         @default(now())
    
    // Relations
    workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    knowledgeEntries KnowledgeEntry[]
    
    @@unique([name, workspaceId])
    @@index([workspaceId])
}

model KnowledgeAgentAccess {
    id              String         @id @default(uuid())
    knowledgeEntryId String
    agentId         String
    accessLevel     String         @default("read") // 'read', 'write'
    createdAt       DateTime       @default(now())
    
    // Relations
    knowledgeEntry  KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)
    agent           Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
    
    @@unique([knowledgeEntryId, agentId])
    @@index([agentId])
}

model KnowledgeTraining {
    id              String         @id @default(uuid())
    knowledgeEntryId String
    status          String         // 'started', 'completed', 'failed'
    startedAt       DateTime       @default(now())
    completedAt     DateTime?
    metrics         Json?          // Training metrics
    errorMessage    String?        // Error details if failed
    triggeredBy     String         // User ID who triggered training
    
    // Relations
    knowledgeEntry  KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)
    user            User           @relation(fields: [triggeredBy], references: [id])
    
    @@index([knowledgeEntryId])
    @@index([status])
    @@index([startedAt])
}

model Project {
    id              String         @id @default(uuid())
    name            String
    slug            String         // URL-friendly identifier
    workspaceId     String
    ownerId         String         // Project owner/creator
    description     String?
    aiContext       String?        // AI context for project understanding
    colorTheme      String?        // Hex color for project theme
    
    // Status and metadata
    status          String         @default("active") // 'active', 'archived', 'completed'
    isPublic        Boolean        @default(false)    // Whether project is publicly accessible
    
    // Timestamps
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    
    // Relations
    workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    owner           User           @relation("ProjectOwner", fields: [ownerId], references: [id])
    canvases        Canvas[]
    agents          ProjectAgent[] // Agents tied to this project
    
    @@unique([workspaceId, slug])
    @@index([workspaceId])
    @@index([ownerId])
    @@index([status])
    @@index([createdAt])
}

model Canvas {
    id          String        @id @default(uuid())
    name        String        @default("Untitled Canvas")
    projectId   String        // Reference to parent project
    type        String        @default("custom") // 'kanban', 'table', 'calendar', 'document', 'custom'
    description String?
    createdBy   String
    
    // Canvas configuration
    config      Json          @default("{}")  // Canvas-specific settings
    aiContext   String?       // AI context for this canvas
    initialPrompt String?     // The AI prompt that created this canvas
    layout      String        @default("freeform") // 'freeform', 'grid', 'linear'
    
    // Status and permissions
    isTemplate  Boolean       @default(false)
    isPublic    Boolean       @default(false)
    
    // Timestamps
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    
    // Relations
    project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
    creator     User          @relation("CanvasCreator", fields: [createdBy], references: [id])
    blocks      Block[]
    
    @@index([projectId])
    @@index([createdBy])
    @@index([type])
    @@index([createdAt])
}

model Block {
    id          String       @id @default(uuid())
    canvasId    String
    type        String       // 'text', 'table', 'chart', 'agent', 'kanban', 'calendar', 'document', etc.
    order       Int          // Order position in canvas
    x           Float?       // X coordinate for free-form layouts
    y           Float?       // Y coordinate for free-form layouts
    width       Float?       // Block width
    height      Float?       // Block height
    
    // Block content and configuration
    title       String?      // Block title
    content     Json         @default("{}") // Block data content
    config      Json         @default("{}") // Block-specific configuration
    metadata    Json?        // Additional metadata
    
    // Block properties
    isCollapsed Boolean      @default(false)
    isLocked    Boolean      @default(false)
    createdBy   String
    
    // Timestamps
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    
    // Relations
    canvas      Canvas       @relation(fields: [canvasId], references: [id], onDelete: Cascade)
    creator     User         @relation("BlockCreator", fields: [createdBy], references: [id])
    
    @@index([canvasId])
    @@index([order])
    @@index([type])
    @@index([createdBy])
    @@index([createdAt])
}

model ProjectAgent {
    id          String       @id @default(uuid())
    projectId   String
    agentId     String
    role        String       @default("assistant") // 'assistant', 'analyst', 'reviewer', etc.
    isActive    Boolean      @default(true)
    config      Json?        // Project-specific agent configuration
    createdAt   DateTime     @default(now())
    
    // Relations
    project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
    agent       Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
    
    @@unique([projectId, agentId])
    @@index([projectId])
    @@index([agentId])
}

// Legacy model - keeping for backward compatibility, will be deprecated
model CanvasLayout {
    id          String        @id @default(uuid())
    workspaceId String
    name        String        @default("Untitled Canvas")
    description String?
    createdBy   String
    initialPrompt String?     // The AI prompt that created this canvas
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    
    // Relations
    workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    blocks      CanvasBlock[]
    
    @@index([workspaceId])
    @@index([createdAt])
}

model CanvasBlock {
    id          String       @id @default(uuid())
    canvasId    String
    type        String       // 'text', 'table', 'chart', 'task-list', 'kanban', 'calendar', etc.
    position    Int          // Order position in canvas
    x           Float?       // X coordinate for free-form layouts
    y           Float?       // Y coordinate for free-form layouts
    width       Float?       // Block width
    height      Float?       // Block height
    
    // Block Configuration
    title       String?      // Block title
    config      Json         // Block-specific configuration
    data        Json?        // Block data content
    metadata    Json?        // Additional metadata
    
    // Timestamps
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    
    // Relations
    canvas      CanvasLayout @relation(fields: [canvasId], references: [id], onDelete: Cascade)
    
    @@index([canvasId])
    @@index([position])
    @@index([type])
}

model Note {
    id          String    @id @default(uuid())
    title       String
    content     String
    workspaceId String
    createdBy   String
    
    // Note Properties
    color       String?   // Color theme for the note
    isPinned    Boolean   @default(false)
    isArchived  Boolean   @default(false)
    
    // Metadata
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    
    // Relations
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    creator     User      @relation("NoteCreator", fields: [createdBy], references: [id])
    tags        NoteTag[]
    
    @@index([workspaceId])
    @@index([createdBy])
    @@index([isPinned])
    @@index([isArchived])
    @@index([createdAt])
}

model Jot {
    id          String    @id @default(uuid())
    text        String    // Quick text content
    workspaceId String
    createdBy   String
    
    // Jot Properties
    color       String?   // Color theme for the jot
    completed   Boolean   @default(false) // For task-like jots
    priority    String?   // high, medium, low
    
    // Metadata
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    
    // Relations
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    creator     User      @relation("JotCreator", fields: [createdBy], references: [id])
    
    @@index([workspaceId])
    @@index([createdBy])
    @@index([completed])
    @@index([priority])
    @@index([createdAt])
}

model NoteTag {
    id        String @id @default(uuid())
    name      String
    color     String?
    noteId    String
    createdAt DateTime @default(now())
    
    // Relations
    note      Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
    
    @@index([noteId])
    @@index([name])
}

// Notifications System
model Notification {
    id          String   @id @default(uuid())
    recipientId String   // User who receives the notification
    workspaceId String?  // Optional - workspace-specific notifications
    
    // Content
    title       String   // Short title/summary
    message     String   // Full notification message
    type        String   // 'system', 'activity', 'collaboration', 'task', 'security'
    category    String?  // More specific categorization within type
    priority    String   @default("medium") // 'critical', 'high', 'medium', 'low'
    
    // Status & Delivery
    isRead      Boolean  @default(false)
    readAt      DateTime?
    deliveryChannels Json // Array of channels: ['in-app', 'email', 'push']
    emailSent   Boolean  @default(false)
    emailSentAt DateTime?
    
    // Action & Context
    actionUrl   String?  // URL to navigate when clicked
    actionText  String?  // Text for action button
    resourceId  String?  // ID of related resource (agent, note, etc.)
    resourceType String? // Type of resource ('agent', 'note', 'jot', 'workspace', etc.)
    
    // Metadata
    metadata    Json?    // Additional context data
    expiresAt   DateTime? // Optional expiration for temporary notifications
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    
    // Relations
    recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
    workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    
    @@index([recipientId])
    @@index([workspaceId])
    @@index([type])
    @@index([priority])
    @@index([isRead])
    @@index([createdAt])
    @@index([expiresAt])
}

model NotificationTemplate {
    id          String   @id @default(uuid())
    name        String   @unique // Template identifier
    type        String   // Notification type this template is for
    category    String?  // Category within type
    
    // Template Content
    titleTemplate   String // Template with placeholders like {{agentName}}
    messageTemplate String // Message template with placeholders
    emailTemplate   String? // HTML email template (optional)
    
    // Settings
    defaultPriority String @default("medium")
    defaultChannels Json   // Default delivery channels
    isActive        Boolean @default(true)
    
    // Metadata
    description     String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    
    @@index([type])
    @@index([category])
    @@index([isActive])
}

model NotificationPreference {
    id          String   @id @default(uuid())
    userId      String
    workspaceId String?  // Optional - workspace-specific preferences
    
    // Preference Settings
    type        String   // Notification type
    category    String?  // Specific category
    channels    Json     // Preferred delivery channels
    enabled     Boolean  @default(true)
    priority    String?  // Minimum priority level to receive
    
    // Scheduling
    quietHoursStart String? // Format: "22:00" for 10 PM
    quietHoursEnd   String? // Format: "08:00" for 8 AM
    timezone        String? // User's timezone
    
    // Frequency Control
    digestMode      Boolean @default(false) // Bundle notifications into digest
    digestFrequency String? // 'daily', 'weekly', 'immediately'
    
    // Metadata
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    
    // Relations
    user        User     @relation("NotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
    workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    
    @@unique([userId, workspaceId, type, category])
    @@index([userId])
    @@index([workspaceId])
    @@index([type])
}

model NotificationDigest {
    id          String   @id @default(uuid())
    userId      String
    workspaceId String?
    
    // Digest Settings
    frequency   String   // 'daily', 'weekly'
    scheduleDay String?  // For weekly: 'monday', 'tuesday', etc.
    scheduleTime String  // Time to send: "09:00"
    timezone    String   @default("UTC")
    
    // Content Filters
    includeTypes     Json // Array of notification types to include
    minPriority      String @default("medium")
    maxNotifications Int    @default(20) // Max notifications per digest
    
    // Delivery Status
    lastSentAt       DateTime?
    nextScheduledAt  DateTime?
    isActive         Boolean @default(true)
    
    // Metadata
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    
    // Relations
    user        User     @relation("NotificationDigests", fields: [userId], references: [id], onDelete: Cascade)
    workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    
    @@unique([userId, workspaceId, frequency])
    @@index([userId])
    @@index([workspaceId])
    @@index([isActive])
    @@index([nextScheduledAt])
}

model AssistantMessage {
    id          String   @id @default(uuid())
    userId      String
    workspaceId String
    role        String   // 'user' or 'assistant'
    content     String
    timestamp   DateTime @default(now())

    user        User      @relation(fields: [userId], references: [id])
    workspace   Workspace @relation(fields: [workspaceId], references: [id])

    @@index([userId])
    @@index([workspaceId])
    @@index([timestamp])
}

model Usage {
    id        String   @id @default(uuid())
    userId    String   @unique
    user      User     @relation(fields: [userId], references: [id])
    requests  Int      @default(0)
    tokens    Int      @default(0)
    lastReset DateTime @default(now())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model CustomAction {
    id          String   @id @default(uuid())
    name        String
    description String
    category    String   // 'api', 'file', 'web', 'system', 'data', 'communication'
    parameters  Json     // Array of parameter definitions
    code        String   // Custom action code
    isPublic    Boolean  @default(false)
    createdBy   String
    usageCount  Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    
    // Relations
    user        User     @relation(fields: [createdBy], references: [id])
    
    @@index([createdBy])
    @@index([category])
    @@index([isPublic])
}

model Workflow {
    id             String         @id @default(uuid())
    name           String
    description    String?
    triggers       String[]       // ['manual', 'file_upload', 'schedule', 'webhook']
    isActive       Boolean        @default(true)
    workspaceId    String?
    createdBy      String
    executionCount Int            @default(0)
    lastExecuted   DateTime?
    // Visual workflow data (React Flow format)
    visualData     Json?          // Stores { nodes: Node[], edges: Edge[] } for visual workflows
    workflowType   String         @default("sequential") // 'sequential' or 'visual'
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt
    
    // Relations
    user           User           @relation(fields: [createdBy], references: [id])
    workspace      Workspace?     @relation(fields: [workspaceId], references: [id])
    steps          WorkflowStep[]
    
    @@index([createdBy])
    @@index([workspaceId])
    @@index([isActive])
}

model WorkflowStep {
    id          String   @id @default(uuid())
    workflowId  String
    actionName  String
    parameters  Json     // Action parameters
    condition   String?  // Conditional logic for step execution
    dependsOn   String[] // IDs of steps this step depends on
    position    Int      // Order of execution
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    
    // Relations
    workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
    
    @@index([workflowId])
    @@index([position])
}

model AgentTask {
    id            String    @id @default(uuid())
    agentId       String
    type          String    // 'reminder', 'document', 'notification', 'meeting', 'knowledge', 'custom'
    parameters    Json      // Task-specific parameters
    status        String    @default("pending") // 'pending', 'in_progress', 'completed', 'failed', 'cancelled'
    result        Json?     // Task execution result
    createdBy     String
    scheduledFor  DateTime? // When the task should be executed
    completedAt   DateTime? // When the task was completed
    logs          Json?     // Execution logs and metadata
    retryCount    Int       @default(0)
    maxRetries    Int       @default(3)
    priority      String    @default("medium") // 'low', 'medium', 'high', 'urgent'
    tags          String[]  // For categorization and filtering
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    
    // Relations
    agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
    creator       User      @relation("AgentTaskCreator", fields: [createdBy], references: [id])
    
    @@index([agentId])
    @@index([status])
    @@index([type])
    @@index([priority])
    @@index([scheduledFor])
    @@index([createdAt])
    @@index([createdBy])
}

model ChatChannel {
    id          String   @id @default(uuid())
    workspaceId String
    name        String
    isPrivate   Boolean  @default(false)
    createdBy   String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now())

    workspace   Workspace @relation("WorkspaceChatChannels", fields: [workspaceId], references: [id])
    creator     User      @relation("UserChatChannels", fields: [createdBy], references: [id])
    messages    ChatMessage[]
    members     ChatChannelMember[]

    @@unique([workspaceId, name])
    @@index([workspaceId])
}

model ChatChannelMember {
    id          String   @id @default(uuid())
    channelId   String
    userId      String
    joinedAt    DateTime @default(now())

    channel     ChatChannel @relation(fields: [channelId], references: [id])
    user        User        @relation("UserChatChannelMembers", fields: [userId], references: [id])

    @@unique([channelId, userId])
    @@index([userId])
}

model ChatMessage {
    id            String   @id @default(uuid())
    channelId     String
    userId        String
    content       String
    threadRootId  String?  // If this is a reply, points to the root message
    blockId       String?  // If linked to a canvas block
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())

    channel       ChatChannel @relation(fields: [channelId], references: [id])
    user          User        @relation("UserChatMessages", fields: [userId], references: [id])
    threadRoot    ChatMessage? @relation("ThreadRoot", fields: [threadRootId], references: [id])
    threadReplies ChatMessage[] @relation("ThreadRoot")

    feedback      Feedback[] @relation("MessageFeedback")

    @@index([channelId])
    @@index([threadRootId])
    @@index([blockId])
}

model Feedback {
    id          String   @id @default(uuid())
    userId      String
    targetType  String   // 'block', 'message', 'insight'
    targetId    String
    rating      Int      // e.g., 1-5 or -1/0/1
    comment     String?
    createdAt   DateTime @default(now())
    messageId   String?  // For message feedback

    user        User     @relation("UserFeedbacks", fields: [userId], references: [id])
    message     ChatMessage? @relation("MessageFeedback", fields: [messageId], references: [id])

    @@index([targetType, targetId])
    @@index([userId])
}
